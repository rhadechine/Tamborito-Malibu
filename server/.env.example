# Copiar a .env y ajustar valores. Nunca commitear el .env real.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Rate limiting (sección 48; el contador vive en Redis) ---
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_AUTH=10/min
THROTTLE_REGISTER=5/hour
THROTTLE_DONATION=10/hour
THROTTLE_UPLOAD=30/hour
THROTTLE_WEBHOOK=240/min
THROTTLE_VERIFY=20/min

# --- Subida de archivos (sección 15) ---
# Bytes. Los tipos permitidos se declaran en MEDIA_ALLOWED_UPLOAD_TYPES
# (config/settings/base.py), no por variable de entorno.
MEDIA_MAX_UPLOAD_SIZE=26214400

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (via PgBouncer, ver sección 31.1) ---
DATABASE_HOST=pgbouncer
DATABASE_PORT=6432
DATABASE_NAME=tamborito
DATABASE_USER=tamborito
DATABASE_PASSWORD=tamborito

# Usados directamente por el contenedor de PostgreSQL y por PgBouncer
# para conectarse a él (ver docker-compose.yml).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ / Celery ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Storage (S3 / MinIO) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=tamborito
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# --- Pasarela de pago (PayU Latam / PSE) ---
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_TEST_MODE=True
PAYU_CHECKOUT_URL=https://sandbox.checkout.payulatam.com/ppp-web-gateway-payu/
PAYU_RESPONSE_URL=http://localhost:5173/payments/return
PAYU_CONFIRMATION_URL=http://localhost:8000/api/v1/payments/webhooks/payu

# Transaction API (reembolsos) — distinta de la de WebCheckout de arriba.
PAYU_API_LOGIN=
PAYU_TRANSACTION_API_URL=https://sandbox.api.payulatam.com/payments-api/4.0/service.cgi
